# Copy to .env.local (untracked) and fill in; run.ps1 reads .env.local.
# The server refuses to start without DATABASE_URL and a strong
# INTERNAL_API_TOKEN.

# The Go API's own least-privilege role (db/api_role.sql). For a first run
# before the role exists, the schema's owner works too.
DATABASE_URL=postgres://medsum_api:CHANGE_ME@localhost:5432/med_sum?sslmode=disable

# At least 32 characters, the same in scripts/.env.local. Generate one:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_TOKEN=

HTTP_ADDRESS=127.0.0.1:8080
ALLOWED_ORIGINS=http://localhost:5173
