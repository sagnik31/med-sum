# Settings of the MCP server (python -m medsum_mcp). Copy to mcp.env.local
# (untracked) and fill it in. A variable set in the environment wins.

# Synthetic data only: the server starts only in development.
MEDSUM_ENV=dev

# The Go API it reads through.
MEDSUM_MCP_API_URL=http://localhost:8080

# The server's own clinician account (create it for this alone; see the
# README's "MCP server" section). Every tool call is audited as it.
MEDSUM_MCP_EMAIL=
MEDSUM_MCP_PASSWORD=
