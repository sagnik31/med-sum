{
  "$defs": {
    "Allergy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "corrections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Correction"
          },
          "title": "Corrections",
          "type": "array"
        },
        "printed": {
          "$ref": "#/$defs/PrintedAllergy"
        },
        "derived": {
          "$ref": "#/$defs/AllergyDerived"
        }
      },
      "required": [
        "id",
        "printed"
      ],
      "title": "Allergy",
      "type": "object"
    },
    "AllergyDerived": {
      "additionalProperties": false,
      "properties": {
        "no_known_allergies": {
          "default": false,
          "title": "No Known Allergies",
          "type": "boolean"
        }
      },
      "title": "AllergyDerived",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "Where an item is printed: lines of one page's numbered transcription.",
      "properties": {
        "page": {
          "description": "Page number, starting at 1.",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "first_line": {
          "description": "First line number of the item.",
          "minimum": 1,
          "title": "First Line",
          "type": "integer"
        },
        "last_line": {
          "description": "Last line number; the same as first_line for one line.",
          "minimum": 1,
          "title": "Last Line",
          "type": "integer"
        },
        "quote": {
          "description": "The text of those lines, copied exactly, without line numbers.",
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "page",
        "first_line",
        "last_line",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ComputedFlag": {
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "title": "ComputedFlag",
      "type": "string"
    },
    "ConditionKind": {
      "enum": [
        "diagnosis",
        "provisional_diagnosis",
        "impression",
        "history"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "ConvertedValue": {
      "additionalProperties": false,
      "description": "A value converted from a fixed table in code; the printed value stays.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "from_unit": {
          "title": "From Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "from_unit"
      ],
      "title": "ConvertedValue",
      "type": "object"
    },
    "Correction": {
      "additionalProperties": false,
      "description": "A value a clinician entered. It sits next to the original extraction,\nwhich is never overwritten.",
      "properties": {
        "field": {
          "description": "Field of the printed item, e.g. value_text.",
          "title": "Field",
          "type": "string"
        },
        "original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original"
        },
        "corrected": {
          "title": "Corrected",
          "type": "string"
        },
        "clinician": {
          "title": "Clinician",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "field",
        "original",
        "corrected",
        "clinician",
        "at"
      ],
      "title": "Correction",
      "type": "object"
    },
    "DateSource": {
      "description": "Which rule chose the document date (decision 13).",
      "enum": [
        "report_date",
        "collection_date",
        "prescription_date",
        "undated"
      ],
      "title": "DateSource",
      "type": "string"
    },
    "DocumentDates": {
      "additionalProperties": false,
      "properties": {
        "report_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Date"
        },
        "collection_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection Date"
        },
        "prescription_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prescription Date"
        },
        "document_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Date"
        },
        "date_source": {
          "$ref": "#/$defs/DateSource",
          "default": "undated"
        }
      },
      "title": "DocumentDates",
      "type": "object"
    },
    "DocumentType": {
      "enum": [
        "lab_report",
        "prescription",
        "other",
        "discharge_summary",
        "imaging_report"
      ],
      "title": "DocumentType",
      "type": "string"
    },
    "DoseSchedule": {
      "additionalProperties": false,
      "description": "A parsed frequency: 1-0-1 is morning 1, noon 0, night 1; BD is twice a day.",
