        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "substance": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Substance"
        },
        "reaction": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reaction"
        }
      },
      "required": [
        "citation",
        "text",
        "substance",
        "reaction"
      ],
      "title": "PrintedAllergy",
      "type": "object"
    },
    "PrintedCondition": {
      "additionalProperties": false,
      "description": "A diagnosis, impression or history exactly as printed. Never inferred.",
      "properties": {
        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "kind": {
