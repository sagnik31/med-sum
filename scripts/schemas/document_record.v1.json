        },
        "test_name": {
          "minLength": 1,
          "title": "Test Name",
          "type": "string"
        },
        "value_text": {
          "description": "The result exactly as printed.",
          "minLength": 1,
          "title": "Value Text",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "reference_ranges": {
          "description": "Every printed reference range or interval, each exactly as printed.",
