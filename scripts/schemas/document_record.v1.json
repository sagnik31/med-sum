      },
      "required": [
        "citation",
        "panel",
        "test_name",
        "value_text",
        "unit",
        "reference_ranges",
        "flag_printed"
      ],
      "title": "PrintedLabResult",
      "type": "object"
    },
    "PrintedMedicine": {
      "additionalProperties": false,
      "description": "One prescribed medicine, exactly as written.",
      "properties": {
        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "form": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "e.g. Tab, Cap, Syp, Inj.",
          "title": "Form"
        },
        "name": {
          "description": "The name as written; brand names stay brands.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "strength": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "e.g. 500 mg.",
          "title": "Strength"
        },
        "dose": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Amount per dose, e.g. 1 tab, 5 ml.",
          "title": "Dose"
        },
        "frequency": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "e.g. 1-0-1, BD, TDS, SOS.",
          "title": "Frequency"
        },
        "route": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Route"
        },
        "duration": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "e.g. x 5 days.",
          "title": "Duration"
        },
        "instructions": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "e.g. after food.",
          "title": "Instructions"
        }
      },
      "required": [
        "citation",
        "form",
        "name",
        "strength",
        "dose",
        "frequency",
        "route",
        "duration",
        "instructions"
      ],
      "title": "PrintedMedicine",
      "type": "object"
