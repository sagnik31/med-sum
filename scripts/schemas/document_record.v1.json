            "minLength": 1,
            "type": "string"
          },
          "title": "Reference Ranges",
          "type": "array"
        },
        "flag_printed": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A flag printed next to the result, e.g. H, L, * or CRITICAL.",
