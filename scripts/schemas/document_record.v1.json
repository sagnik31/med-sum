    "PrintedLabResult": {
      "additionalProperties": false,
      "description": "One row of a lab report.",
      "properties": {
        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "panel": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The section heading the test is under, e.g. 'COMPLETE BLOOD COUNT'.",
