    },
    "ObservationDerived": {
      "additionalProperties": false,
      "properties": {
        "analyte": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key in the unit table; same test across documents.",
          "title": "Analyte"
        },
        "value_num": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only when the printed value parses without guessing.",
          "title": "Value Num"
        },
        "ranges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReferenceRange"
          },
          "title": "Ranges",
          "type": "array"
        },
        "flag_computed": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComputedFlag"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only when exactly one range clearly applies."
        },
        "converted": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConvertedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ObservationDerived",
      "type": "object"
    },
    "PageTranscription": {
      "additionalProperties": false,
      "description": "One page as transcribed by the vision model, split into lines. Line n\nis lines[n - 1]; every citation points into these lines.",
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "lines": {
          "items": {
            "type": "string"
          },
          "title": "Lines",
          "type": "array"
        },
        "text_layer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The PDF's own text for this page, when it has one.",
          "title": "Text Layer"
        }
      },
      "required": [
        "page",
        "lines"
      ],
      "title": "PageTranscription",
      "type": "object"
    },
