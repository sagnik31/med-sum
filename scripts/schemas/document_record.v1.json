        "times_per_day": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Times Per Day"
        },
        "as_needed": {
          "default": false,
          "title": "As Needed",
          "type": "boolean"
        }
      },
      "title": "DoseSchedule",
      "type": "object"
    },
