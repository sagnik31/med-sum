# Copy to .env.local (untracked) and fill in; run.ps1 reads .env.local.
# The service refuses to start without a strong INTERNAL_API_TOKEN.

# The same value as INTERNAL_API_TOKEN in backend/.env.local.
INTERNAL_API_TOKEN=

# Development only: without DATABASE_URL, the service uses the local
# med_sum database as postgres (scripts/src/settings.py). Anywhere else, set
# DATABASE_URL, ideally to the medsum_ai role (docs/setup.md, "Database roles").
MEDSUM_ENV=dev
# DATABASE_URL=postgres://medsum_ai:CHANGE_ME@localhost:5432/med_sum?sslmode=disable

# The share of verified documents sent back to a clinician as an audit (0 to 1).
# MEDSUM_AUDIT_SAMPLE_RATE=0.10
