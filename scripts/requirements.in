# Direct dependencies of the AI service. requirements.txt pins every package;
# regenerate it after editing this file:
#   uv pip compile requirements.in --universal --python-version 3.10 -o requirements.txt
beautifulsoup4
fastapi
httpx
# LangGraph runs the document pipeline; its Postgres checkpointer needs psycopg 3
langgraph
langgraph-checkpoint-postgres
ollama
psycopg[binary]
pydantic
# 2.x adds layout analysis with onnxruntime and numpy; we only render pages to images
pymupdf<2
uvicorn
